{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "hooks/cos-channel-bootout.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "hooks/cos-channel-bootstrap.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
